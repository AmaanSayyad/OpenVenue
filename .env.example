# Binance Web3 Developer Portal credentials
# https://web3.binance.com/en/dev-portal
OC_API_KEY=BX-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
OC_SECRET_KEY=your_secret_key_here

# Optional: wallet private key for server-side demo signing (never commit)
# DEMO_PRIVATE_KEY=0x...

# Public app URL. Production is https://openvenue.xyz
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=56

# Reown project id from https://dashboard.reown.com
NEXT_PUBLIC_PROJECT_ID=your_reown_project_id

# Venue Tape seller (BNB Agent Studio). Start with: cd venuetape && bag dev
VENUE_TAPE_URL=http://127.0.0.1:9000

# B402 receiving address from the Developer Portal (write-once per project).
# The same OC_API_KEY must have the B402 Payments permission ticked.
# B402_PAY_TO=0xYourMerchantAddress
